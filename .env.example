# ==========================================
# 个人实习生简历 AI Agent - 环境配置文件
# 复制此文件为 .env 并填入真实配置
# ==========================================

# ---------- LLM API 配置 ----------
# API供应商：支持 openai / dashscope / custom
LLM_PROVIDER=openai

# API密钥（必填）
LLM_API_KEY=your_api_key_here

# API基础地址
# OpenAI: https://api.openai.com/v1
# 阿里云DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
# OpenAI: gpt-4o-mini / gpt-4o / gpt-3.5-turbo
# DashScope: qwen-plus / qwen-turbo / qwen-max
LLM_MODEL=gpt-4o-mini

# 请求超时时间（秒）
LLM_TIMEOUT=60

# 温度参数（0-1，越低越稳定）
LLM_TEMPERATURE=0.7

# ---------- 服务配置 ----------
# 服务监听地址
HOST=0.0.0.0

# 服务端口
PORT=8000

# 调试模式
DEBUG=true

# ---------- 数据库配置 ----------
# SQLite数据库路径
DATABASE_URL=sqlite:///./data/resume_agent.db

# ---------- 安全配置 ----------
# API访问密钥（可选，留空则不开启验证）
API_SECRET=
